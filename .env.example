# PGFinder Backend Environment Configuration Template
PORT=5000
NODE_ENV=production
CLIENT_URL=http://localhost:5173

# Database Connection URI (MongoDB Atlas or local)
MONGODB_URI=mongodb://localhost:27017/pgfinder

# JSON Web Token Secret & Expiry
JWT_SECRET=your_super_secret_jwt_key_min_32_characters
JWT_EXPIRE=30d

# Storage & Third-Party Service Credentials (Optional)
STORAGE_BUCKET=
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=
EMAIL_PASSWORD=
